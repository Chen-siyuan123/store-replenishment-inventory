root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 110

[*.{html,css,js,json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows 批处理必须是 CRLF，否则 cmd 解析异常
[*.bat]
end_of_line = crlf
