# ============================================================
# 配置模板：复制为 .env 后填入自己的密钥
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# 服务地址（智谱 Open Platform，OpenAI 兼容协议）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# API Key（智谱格式：<id>.<secret>，在控制台「API Keys」页创建）
LLM_API_KEY=请填写你的key

# 对话模型：GLM-4-Flash 为免费版，支持流式与 Function Calling
LLM_MODEL=glm-4-flash

# 向量模型：必须是 embedding-3，不能填对话模型名（会返回 400）
# 留空则向量检索降级为哈希伪向量（仅关键词检索有效），启动时会告警
LLM_EMBED_MODEL=embedding-3

# ---- 检索门限（可选）----
# 四个门限定成「什么算相关、什么算知识库里没有」的判据：
#   语义强命中（≥0.68）           → 直接放行（应对「这个能拆开送吗」这类口语化提问）
#   语义中等（≥0.55）且关键词有密度 → 放行
#   两者都不满足                   → 返回空，回答「制度中未找到」
# 换 embedding 供应商或换语料后分数分布会变，务必重跑 eval/probe_retrieval.py 重新标定。
# KB_VEC_MIN_INFO=0.30        # 语义路可信下限：低于它认为向量是噪声，退化为纯 BM25
# KB_VEC_MIN_HIT=0.55         # 语义中等命中下限
# KB_VEC_STRONG_HIT=0.68      # 语义强命中下限
# KB_BM25_MIN_DENSITY=0.20    # 每词平均 BM25 得分下限（关键词证据）
